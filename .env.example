# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
AUTH_MODE=development
DATABASE_URL=postgresql://zyteron:zyteron@localhost:5432/zyteron_control
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONITORING_PROCESS_ROLE=api
MONITORING_WORKER_ENABLED=false
MONITORING_TICK_MS=15000
MONITORING_MAX_CONCURRENCY=8
MONITORING_ALLOWED_PORTS=80,443,8080,8443
MONITORING_MAIL_FROM=
RESEND_API_KEY=
# URL pública de la API; se usa para callbacks firmados de proveedores externos.
PUBLIC_API_URL=http://localhost:4000/api

# Emisión DTE directa SII (sólo en el servicio API; nunca en NEXT_PUBLIC_*).
# Bundle PEM que contiene certificado y llave privada. En producción configúralo como Secret File/Variable de Render.
DTE_CERTIFICATE_SECRET_REF=DTE_CERTIFICATE_PEM
DTE_CERTIFICATE_PEM=
DTE_CERTIFICATE_PEM_PASSPHRASE=
DTE_SENDER_RUT=
FINANCE_ENCRYPTION_KEY=
# Opcional: los cuatro XSD oficiales ya vienen incluidos. Define esta ruta sólo para reemplazarlos de forma controlada.
DTE_XSD_DIR=

# Alternativa: proveedor DTE certificado externo.
DTE_PROVIDER_URL=
DTE_PROVIDER_API_KEY=

# Firma electrónica externa para contratos, anexos laborales y documentos.
ELECTRONIC_SIGNATURE_PROVIDER_NAME=EXTERNAL
ELECTRONIC_SIGNATURE_PROVIDER_URL=
ELECTRONIC_SIGNATURE_API_KEY=
ELECTRONIC_SIGNATURE_WEBHOOK_SECRET=
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_VAULT_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
AUTH_PERMISSION_CACHE_MS=60000
AUTH_OBSERVATION_CACHE_MS=5000
QUOTE_ISSUER_NAME=Zyteron SpA
QUOTE_ISSUER_RUT=78.398.774-0
QUOTE_ISSUER_ACTIVITY=Servicios de informática y desarrollo de software
QUOTE_ISSUER_ADDRESS=Santiago, Chile
QUOTE_ISSUER_WEBSITE=www.zyteron.cl
QUOTE_ISSUER_EMAIL=contacto@zyteron.cl
QUOTE_ISSUER_PHONE=
# Configura estos datos solo en el entorno privado de la API. No publiques una cuenta real en Git.
QUOTE_BANK_NAME=
QUOTE_BANK_ACCOUNT_TYPE=
QUOTE_BANK_ACCOUNT_NUMBER=

# Web. El rol de desarrollo nunca debe habilitarse en producción.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_DEV_ROLE=GERENTE_GENERAL
NEXT_PUBLIC_DEV_AAL=aal2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
