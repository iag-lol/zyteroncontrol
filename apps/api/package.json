    "@zyteron/contracts": "workspace:*",
    "dotenv": "18.0.4",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "24.7.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
