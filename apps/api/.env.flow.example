# Server only. Isolated staging; never point Sandbox at the production Finance database.
FLOW_ENVIRONMENT=sandbox
FLOW_LIVE_PAYMENTS_ENABLED=false
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_TOKEN_ENCRYPTION_KEY=
FLOW_CONFIRMATION_URL=https://CONTROL-STAGING.example/api/webhooks/payments/flow
FLOW_RETURN_URL=https://PORTAL-STAGING.example/api/flow/return
FLOW_REGISTRATION_RETURN_URL=https://PORTAL-STAGING.example/api/flow/registration-return
CLIENT_PORTAL_URL=https://PORTAL-STAGING.example
FLOW_WORKER_ENABLED=false
# No website binding by default. Per-site approval/binding is required.
FLOW_SITE_REGISTRY=[]
RESEND_API_KEY=
PAYMENT_EMAIL_FROM=
FLOW_SANDBOX_EMAIL_ALLOWLIST=
